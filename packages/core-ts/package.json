{
    "name": "@sandlada/symbol-align-ts",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript reference implementation of the code-snippet symbol-alignment formatter - lines up =, :, =>, //, # and more. CLI & API",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/config-fs.d.ts",
            "import": "./dist/config-fs.js"
        }
    },
    "bin": {
        "symbol-align": "./dist/bin.js"
    },
    "files": [
        "dist",
        "schemas",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "SECURITY.md",
        "CODE_OF_CONDUCT.md"
    ],
    "scripts": {
        "bench": "node bench/run.mjs",
        "build": "tsc",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "dev": "tsx src/bin.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "prepublishOnly": "pnpm run build && pnpm run test"
    },
    "keywords": [
        "align",
        "alignment",
        "code",
        "code-snippet",
        "format",
        "formatter",
        "vertical",
        "symbol",
        "equals",
        "colon",
        "arrow",
        "prettier-plugin"
    ],
    "engines": {
        "node": ">=24"
    },
    "author": "Kai Orion",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/symbol-align.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/symbol-align/issues"
    },
    "homepage": "https://github.com/sandlada/symbol-align#readme",
    "devDependencies": {
        "@types/node": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
