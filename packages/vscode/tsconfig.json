{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ESNext",
        "types": ["node", "vscode"],
        "lib": ["ESNext"],
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@sandlada/symbol-align-ts": ["../core-ts/src/index.ts"]
        }
    },
    "include": ["src"]
}
