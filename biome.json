{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!**/dist", "!**/node_modules", "!**/coverage", "!**/*.md", "!pnpm-lock.yaml", "!pnpm-workspace.yaml", "!packages/core/src/generated", "!packages/core/rust/target", "!packages/playground/samples"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 240,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "yaml": {
        "formatter": {
            "indentWidth": 2
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useNamingConvention": "off"
            },
            "suspicious": {
                "noConsole": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["scripts/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/*/src/fixtures.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noTemplateCurlyInString": "off"
                    }
                }
            }
        }
    ]
}
