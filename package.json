{
    "name": "symbol-align",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Monorepo for @sandlada/symbol-align — vertical alignment for code symbols",
    "packageManager": "pnpm@12.14.0",
    "license": "MIT",
    "author": "Kai Orion",
    "homepage": "https://github.com/sandlada/symbol-align#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/symbol-align.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/symbol-align/issues"
    },
    "scripts": {
        "build": "pnpm -r build",
        "build:solution": "tsc --build",
        "clean": "pnpm -r clean",
        "dev": "pnpm --filter @sandlada/symbol-align dev",
        "test": "pnpm -r test",
        "test:watch": "pnpm -r --parallel test:watch",
        "typecheck": "pnpm -r typecheck"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=18",
        "pnpm": ">=9"
    }
}
