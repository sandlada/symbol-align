{
    "name": "symbol-align-workspace",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Monorepo for @sandlada/symbol-align — code-snippet symbol alignment",
    "packageManager": "pnpm@12.14.0",
    "license": "MIT",
    "author": "Kai Orion",
    "homepage": "https://github.com/sandlada/symbol-align#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/symbol-align.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/symbol-align/issues"
    },
    "scripts": {
        "build": "pnpm -r build",
        "build:solution": "tsc --build",
        "bench": "node scripts/benchmark.mjs --label baseline --report report1.md",
        "bench:baseline": "node scripts/benchmark.mjs --label baseline --report report1.md",
        "bench:optimized": "node scripts/benchmark.mjs --label optimized --report report2.md",
        "clean": "pnpm -r clean",
        "dev": "pnpm --filter @sandlada/symbol-align dev",
        "dev:playground": "pnpm --filter @sandlada/symbol-align build:wasm && pnpm --filter @sandlada/playground dev",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "test": "pnpm -r test",
        "test:watch": "pnpm -r --parallel test:watch",
        "typecheck": "pnpm -r typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=10"
    }
}
