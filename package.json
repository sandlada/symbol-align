{
    "name": "@sandlada/symbol-align",
    "version": "0.0.1-20260710.a",
    "description": "Vertical alignment for code symbols (=, :, =>, //, # and more) — CLI & API",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "bin": {
        "symbol-align": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsgo",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build && npm test"
    },
    "keywords": [
        "align",
        "alignment",
        "code",
        "format",
        "vertical",
        "symbol",
        "equals",
        "colon",
        "arrow"
    ],
    "engines": {
        "node": ">=18"
    },
    "author": "Kai Orion",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/symbol-align.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/symbol-align/issues"
    },
    "homepage": "https://github.com/sandlada/symbol-align#readme",
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "tsx": "^4.23.0",
        "vitest": "^4.1.10"
    }
}
